# Dependencies
node_modules/
.pnpm-store/
pnpm-debug.log*

# Local tracker cache (scripts/tracker-cache) — a mirror, not source of truth
.cache/

# Rust / Cargo
target/
**/*.rs.bk
Cargo.lock.bak

# Build output
dist/
build/
*.tsbuildinfo
examples/*/dist/
# Compiler-generated TypeScript sidecar files (type-info artifacts from rolldown plugin)
**/*.aihu.ts

# Vite
.vite/

# Storybook (Plan 6) — static build + synced recipe copies (generated)
apps/storybook/storybook-static/
apps/storybook/src/recipes/

# Rolldown cache files (hashed temp artifacts from build)
rolldown.config.*.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
# .vscode is ignored EXCEPT the shared workspace settings, which carry the
# repos/ vendored-source excludes (see AGENTS.md "Vendored Repositories").
# Personal VS Code state — launch.json, tasks.json, *.log — stays ignored.
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

# Claude Code local settings (machine-specific)
.claude/settings.local.json
# Claude Code scheduled-task lock (transient, machine-local)
.claude/scheduled_tasks.lock
# Claude Code subagent worktrees (transient agent workspaces)
.claude/worktrees/
# team CLI per-developer focus pin (not shared)
.team-context
# agent scratch / temp scaffolds (transient, machine-local)
.context/
# Top-level worktrees (transient feature-branch worktrees)
.worktrees/

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# moon
.moon/cache
.moon/docker

# Bench memory pass intermediate file (folded into RESULTS.md by runner)
bench/signals/RESULTS.memory.json
bench/arbor/RESULTS.memory.json

# Lighthouse CI results (generated by scripts/lighthouse.ts, one per --app)
scripts/lighthouse-results.json
scripts/lighthouse-results-*.json
.gstack/

# VS Code extension build artifacts
*.vsix

# WASM build artifacts (Directive 1 + arch-4 §4.6)
packages/compiler/pkg-wasm/

# Compiler napi addon — locally staged .node binaries (built by
# packages/compiler/scripts/build-native.ts; CI ships them via the
# @aihu/compiler-native-* platform packages). Never commit binaries.
packages/compiler/src-native/*.node
packages/compiler/npm-native/*/*.node

# Agent team session artifacts — director notes, retros, build manifests, state files
# (consolidate ratified specs into docs/superpowers/specs/ and plans into docs/plans/ instead)
.team/
state-*.md
# docs/superpowers/specs/ is a tracked home for ratified specs (v1.0.6 migration);
# other docs/superpowers/ subdirectories below that may appear are session artifacts and stay ignored.
docs/topic-director-notes/
docs/topic-summaries/
docs/build-manifest-*.md
docs/investigation-*.md
docs/retro-*.md
docs/tthw-log.md
docs/spec-headless.md

# Stray session log files
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Stray mis-pathed SSG/worktree output copies dropped at repo root by a
# misresolved output path (e.g. gitfellwork-wt*, gitfellworkaihu-head). Plain
# file copies, never tracked — ignored so biome/CI do not scan them.
/gitfellwork*/

# Local scratch / smoke-test output (never commit)
.scratch-smoke/
.scratch*/

# gbrain's put_page write-through mirrors every page to <project-slug>/<layer>/…
# relative to the repo root, so writing `aihu/delta/...` drops an untracked `aihu/`
# directory into the checkout — and into whichever checkout the MCP server happens
# to be running in, usually the primary one, on someone else's branch. The page
# already lives in the gbrain DB; this copy is litter. The durable record belongs
# in docs/state/ — see docs/state/historian.md.
/aihu/

# Per-agent role marker for the swarm skill. Machine-local identity:
# committing it would hand every checkout one agent's identity.
.agent-role
.codemap/*
!.codemap/config.json
