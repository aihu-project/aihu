{
  "name": "aihu",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/_moved/*",
    "packages/templates/*",
    "bench/*",
    "bench/js-framework-benchmark/*/*",
    "examples/*",
    "apps/*",
    "cookbook"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev:examples": "bun scripts/dev-examples.ts",
    "tracker:sync": "bun scripts/tracker-cache/sync.ts",
    "tracker:query": "bun scripts/tracker-cache/query.ts",
    "build": "moon run :build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config tests/vitest.config.ts",
    "typecheck": "moon run :typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:lint": "biome ci .",
    "check:ci": "bun run check:lint && bun run typecheck && bun run test && bun run build && bun run size && bun run check:size-rows && bun run check:publish-manifest && bun run check:use-registry-parity && bun run check:alias-parity && bun run check:composable-registry && bun run check:rust-pin && bun run check:deps && bun run check:moon-graph && bun run check:runtime-purity && bun run check:grammar-v2 && bun run check:cookbook && bun run check:lesson-refs && bun run check:gate-wiring && bun run check:template-versions && bun run check:platform-version-sync && bun run check:native-changeset && bun run check:css-engine-binary-bump && bun run check:cn-map && bun run check:animations-gallery && bun run check:server-binary-bump && bun run check:lockfile-platform-pins",
    "check:pre-push": "bun run check:lint && bun run typecheck",
    "size": "bun scripts/size.ts",
    "readme:remeasure": "bun scripts/sync-readme.ts --remeasure",
    "check:size-rows": "bun scripts/check-size-rows.ts",
    "check:publish-manifest": "bun scripts/check-publish-manifest.ts",
    "check:skill-samples": "bun skills/aihu/check-samples.ts",
    "check:use-registry-parity": "bun scripts/check-use-registry-parity.ts",
    "check:alias-parity": "bun scripts/check-alias-parity.ts",
    "gen:use": "bun scripts/gen-use.ts",
    "gen:composable-registry": "bun scripts/gen-composable-hover-registry.ts",
    "check:composable-registry": "bun scripts/gen-composable-hover-registry.ts --check",
    "check:runtime-purity": "bun scripts/check-runtime-purity.ts",
    "test:quality": "bun scripts/lighthouse.ts",
    "test:quality:docs-next": "bun scripts/lighthouse.ts --app docs-next",
    "swarm:install": "cargo build --release --manifest-path packages/swarm/Cargo.toml && mkdir -p \"$HOME/.swarm/bin\" && install -m 755 target/release/swarm-bus \"$HOME/.swarm/bin/swarm-bus\" && \"$HOME/.swarm/bin/swarm-bus\" --version",
    "check:deps": "bun scripts/dep-check.ts",
    "check:moon-graph": "bun scripts/check-moon-graph.ts",
    "check:css-engine-binary-bump": "bun scripts/check-css-engine-binary-bump.ts",
    "check:cn-map": "bun packages/css-engine/scripts/gen-cn-conflict-map.ts --check",
    "check:animations-gallery": "bun packages/css-engine/scripts/gen-animations-gallery.ts --check",
    "check:server-binary-bump": "bun scripts/check-server-binary-bump.ts",
    "ci:receipt": "bun scripts/ci-receipt.ts",
    "lint:dep-pins": "bun scripts/lint-dep-pins.ts",
    "drift:pins": "bun scripts/check-pins-published.ts",
    "lint:node-leak": "bun scripts/lint-node-bundle-leaks.ts",
    "check:hmr": "bun scripts/hmr-check.ts",
    "test:cookbook": "bun run --cwd cookbook test",
    "release": "bun run build && bash scripts/publish-all.sh",
    "release:version": "changeset version && bun scripts/stamp-platform-versions.ts --host compiler && bun install && bun scripts/sync-template-versions.ts && bun scripts/sync-readme.ts && bun apps/docs/scripts/gen-api.ts",
    "prepare": "husky",
    "storybook": "bun run --cwd apps/storybook storybook",
    "build-storybook": "bun run --cwd apps/storybook build-storybook",
    "check:stories": "bun scripts/check-required-stories.ts",
    "check:a11y": "bash scripts/check-storybook-a11y.sh",
    "check:emit-parses": "bun scripts/check-emit-parses.ts",
    "check:derived": "bun scripts/check-derived.ts",
    "check:attributed": "bun scripts/check-attributed.ts",
    "check:governed": "AIHU_NATIVE_SKIP=1 bun scripts/check-governed.ts",
    "check:dual-audience": "AIHU_NATIVE_SKIP=1 bun scripts/check-dual-audience.ts",
    "check:hydration-adoption": "AIHU_NATIVE_SKIP=1 bun scripts/check-hydration-adoption.ts",
    "check:thesis": "bun run check:derived && bun run check:attributed && bun run check:governed && bun run check:dual-audience && bun run check:hydration-adoption",
    "check:grammar-v2": "bun scripts/check-grammar-v2.ts",
    "check:cookbook": "bun scripts/check-cookbook-index.ts",
    "check:lesson-refs": "bash scripts/check-lesson-refs.sh",
    "check:coverage-manifest": "bun scripts/check-coverage-manifest.ts",
    "check:gate-wiring": "bun scripts/check-gate-wiring.ts",
    "gen:template-versions": "bun scripts/sync-template-versions.ts",
    "check:template-versions": "bun scripts/sync-template-versions.ts --check",
    "test:scaffold-matrix": "bun packages/cli/tests/scaffold-matrix-e2e.ts",
    "build:governed-examples": "bun scripts/build-governed-examples.ts",
    "check:rust-pin": "bun scripts/check-rust-pin.ts",
    "check:platform-version-sync": "bun scripts/stamp-platform-versions.ts --check --host compiler",
    "check:native-changeset": "bun scripts/check-native-changeset.ts",
    "check:lockfile-platform-pins": "bun scripts/check-lockfile-platform-pins.ts"
  },
  "devDependencies": {
    "@aihu-plugin/agent-readiness": "workspace:*",
    "@aihu-plugin/data": "workspace:*",
    "@aihu/adapter-cloudflare": "workspace:*",
    "@aihu/adapter-vercel": "workspace:*",
    "@aihu/agent": "workspace:*",
    "@aihu/agent-a2a": "workspace:*",
    "@aihu/agent-acp": "workspace:*",
    "@aihu/agent-server": "workspace:*",
    "@aihu/agent-service": "workspace:*",
    "@aihu/app": "workspace:*",
    "@aihu/arbor": "^4.1.2",
    "@aihu/compiler": "workspace:*",
    "@aihu/context": "workspace:*",
    "@aihu/plugin": "workspace:*",
    "@aihu/router": "workspace:*",
    "@aihu/runtime": "workspace:*",
    "@aihu/server": "workspace:*",
    "@aihu/signals": "^0.5.1",
    "@biomejs/biome": "2.4.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "1.59.1",
    "@types/node": "^20.16.5",
    "@vitest/coverage-v8": "^3.2.6",
    "chrome-launcher": "^1.1.2",
    "fast-check": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.0.0",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vite": "^8.0.16",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@aihu/reactive": "^0.2.1"
  }
}
