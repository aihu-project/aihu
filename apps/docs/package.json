{
  "name": "aihu-docs",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "description": "Redesigned aihu documentation + DX site — a full dogfood aihu SSG app (@aihu/app + file router + output:'static').",
  "scripts": {
    "gen:css": "bun gen-css.ts",
    "gen:api": "bun scripts/gen-api.ts",
    "gen:gallery": "bun scripts/gen-gallery.ts",
    "gen:registry": "bun scripts/gen-registry.ts",
    "check:registry": "bun scripts/gen-registry.ts --check",
    "gen:preview": "rolldown -c rolldown.preview.config.ts",
    "gen:wasm": "bun scripts/stage-wasm.ts",
    "prebuild": "bun run gen:api && bun run gen:registry && bun run gen:css && bun run gen:preview && bun run gen:wasm",
    "predev": "bun run gen:registry && bun run gen:css && bun run gen:preview && bun run gen:wasm",
    "dev": "vite --port 5175",
    "build": "vite build",
    "preview": "vite preview --port 5176",
    "shots": "bun scripts/shots.ts",
    "test:e2e": "bunx playwright test"
  },
  "dependencies": {
    "@aihu/agent": "workspace:*",
    "@aihu/app": "workspace:*",
    "@aihu/arbor": "^4.1.2",
    "@aihu/context": "workspace:*",
    "@aihu/css-engine": "workspace:*",
    "@aihu/router": "workspace:*",
    "@aihu/runtime": "workspace:*",
    "@aihu/server": "workspace:*",
    "@aihu/signals": "^0.5.1",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "marked": "^15.0.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@aihu-plugin/agent-readiness": "workspace:*",
    "@aihu/compiler": "1.3.5",
    "@aihu/compiler-wasm": "1.3.5",
    "@playwright/test": "1.59.1",
    "rolldown": "^1.0.0-rc.17",
    "vite": "^8.0.0"
  }
}
