// site layout — the full-bleed shell for marketing/landing pages: shared header,
// a routed <outlet>, and the site footer. No sidebar.

// NO @state BLOCK — deliberately. This layout used to call
// `afterNavigate(() => …)` to reset scroll on client-side navigation, and that
// single line was silently breaking the entire landing page.
//
// `afterNavigate` is a COMPILER INTRINSIC: there is no runtime export to
// import, so the compiler must lower the call away. In the layout build path
// it did not — the literal text `afterNavigate(...)` survived into the emitted
// chunk (verified in `dist/assets/site-*.js`, while `docs-*.js` from the
// otherwise-identical docs layout had zero occurrences). At runtime that threw
// `ReferenceError: afterNavigate is not defined` during the layout's setup,
// which killed the WHOLE `<aihu-layout-site>` element — so the landing page
// rendered its page content with no header and no footer at all. Hoisting the
// callback to a named const (matching docs.aihu) did NOT fix it; the
// difference between the two layouts is still unexplained and is filed as a
// compiler bug rather than guessed at here.
//
// Removing it costs nothing, which is the reason this is a deletion and not a
// workaround: `src/main.ts` already installs a GLOBAL scroll-reset click
// handler, and its own comment says it exists precisely because "a per-layout
// afterNavigate misses cross-layout transitions (site ↔ docs)". The layout
// copy was redundant with a handler that already covers more cases.

@template {
  <div class="dn-site">
    <site-header></site-header>
    <main class="dn-site-main">
      <outlet></outlet>
    </main>
    <footer class="dn-footer">
      <div class="dn-footer-inner">
        <div class="dn-footer-brand">
          <strong>aihu</strong>
          <span>The framework that equally governs humans and AI.</span>
        </div>
        <nav class="dn-footer-nav" aria-label="Footer">
          <a href="/guides/getting-started">Guides</a>
          <a href="/api">API</a>
          <a href="/registry">Registry</a>
          <a href="/examples">Examples</a>
          <a href="https://github.com/aihu-project/aihu">GitHub</a>
        </nav>
      </div>
    </footer>
  </div>
}

@style {
  .dn-site {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .dn-site-main {
    flex: 1;
  }
  .dn-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .dn-footer-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
  }
  .dn-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .dn-footer-brand strong {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .dn-footer-brand span {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .dn-footer-nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .dn-footer-nav a {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .dn-footer-nav a:hover {
    color: var(--accent);
  }
}
