{
  "name": "aihu-storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:recipes": "bun scripts/sync-recipes.ts",
    "storybook": "bun run sync:recipes && storybook dev -p 6006",
    "build-storybook": "bun run sync:recipes && storybook build",
    "test-storybook": "test-storybook --url ${AIHU_STORYBOOK_URL:-http://127.0.0.1:6006}"
  },
  "dependencies": {
    "@aihu/arbor": "^4.1.2",
    "@aihu/compiler": "workspace:*",
    "@aihu/css-engine": "workspace:*",
    "@aihu/primitives": "workspace:*",
    "@aihu/runtime": "workspace:*",
    "@aihu/signals": "^0.5.1",
    "@aihu/ui": "workspace:*",
    "@aihu/use": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/web-components-vite": "^10.4.3",
    "axe-playwright": "^2.2.2",
    "http-server": "^14.1.1",
    "lit": "^3.3.0",
    "storybook": "^10.4.3",
    "vite": "^8.0.0"
  }
}
