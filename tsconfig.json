{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@aihu/signals": ["./packages/signals/src/index.ts"],
      "@aihu/signals/lifecycle": ["./packages/signals/src/lifecycle.ts"],
      "@aihu/arbor": ["./packages/arbor/src/index.ts"],
      "@aihu/arbor/progressive": ["./packages/arbor/src/progressive.ts"],
      "@aihu/runtime": ["./packages/runtime/src/index.ts"],
      // The server-only SSR helper subpath. Without this mapping the
      // specifier resolves through package exports to runtime/dist, which
      // only exists after a build — so any package that typechecks
      // @aihu/server's source (auth, mcp, …) fails TS2307 on a clean tree.
      // Same shape as @aihu/context/ssr below.
      "@aihu/runtime/ssr": ["./packages/runtime/src/ssr-string.ts"],
      "@aihu/primitives/focus-trap": ["./packages/primitives/src/dialog/focus-trap.ts"],
      "@aihu/agent": ["./packages/agent/src/index.ts"],
      "@aihu/context": ["./packages/context/src/index.ts"],
      "@aihu/context/ssr": ["./packages/context/src/ssr.ts"],
      "@aihu/server": ["./packages/server/src/index.ts"],
      "@aihu/router": ["./packages/router/src/index.ts"],
      "@aihu/router/server": ["./packages/router/src/server.ts"],
      "@aihu/agent-service": ["./packages/agent-service/src/index.ts"],
      "@aihu/agent-server": ["./packages/agent-server/src/index.ts"],
      "@aihu-plugin/agent-readiness": ["./packages/plugin-agent-readiness/src/index.ts"],
      "@aihu/plugin": ["./packages/plugin/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "tests/**/*.ts"]
}
