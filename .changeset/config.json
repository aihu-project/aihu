{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "aihu-project/aihu" }],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "snapshot": {
    "useCalculatedVersion": false,
    "prereleaseTemplate": "{tag}-{commit}"
  },
  "updateInternalDependencies": "patch",
  "___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
    "onlyUpdatePeerDependentsWhenOutOfRange": true
  },
  "ignore": [
    "aihu-docs",
    "@aihu/bench-arbor",
    "@aihu/bench-signals",
    "@aihu/example-blog-loader",
    "@aihu/example-blog-router",
    "@aihu/example-color-theme",
    "@aihu/example-css-engine-utility",
    "aihu-example-css-pluggability",
    "@aihu/example-hacker-news",
    "@aihu/example-layouts",
    "@aihu/example-live-counter",
    "@aihu/example-temperature-converter",
    "@aihu/example-timer",
    "@aihu/example-todo-mvc",
    "vscode-aihu"
  ]
}
