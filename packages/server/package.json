{
  "name": "@aihu/server",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./head-lowering": {
      "types": "./dist/head-lowering.d.ts",
      "import": "./dist/head-lowering.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/agent": "workspace:*",
    "@aihu/agent-service": "workspace:*",
    "@aihu/plugin": "workspace:*",
    "@aihu/signals": "^0.5.1"
  },
  "optionalDependencies": {
    "@aihu/server-darwin-arm64": "0.1.2",
    "@aihu/server-darwin-x64": "0.1.2",
    "@aihu/server-linux-x64-gnu": "0.1.2",
    "@aihu/server-win32-x64-msvc": "0.1.2"
  },
  "description": "Server runtime + native renderer (napi-rs) for aihu SSR.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/server#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@aihu/runtime": "workspace:*"
  }
}
