{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "outDir": "./dist",
    "noEmit": true,
    "declaration": true,
    "declarationDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@aihu/app": ["../app/src/index.ts"],
      "@aihu/router": ["../router/src/index.ts"],
      "@aihu/router/plugin": ["../router/src/plugin.ts"],
      "@aihu-plugin/agent-readiness": ["../plugin-agent-readiness/src/index.ts"],
      "@aihu/agent-service": ["../agent-service/src/index.ts"],
      "@aihu/runtime/ssr": ["../runtime/src/ssr-string.ts"],
      "@aihu/server": ["../server/src/index.ts"],
      "@aihu/agent": ["../agent/src/index.ts"],
      "@aihu/server/head-lowering": ["../server/src/head-lowering.ts"],
      "@aihu/plugin": ["../plugin/src/index.ts"],
      "@aihu/runtime": ["../runtime/src/index.ts"],
      "@aihu/primitives/focus-trap": ["../primitives/src/dialog/focus-trap.ts"],
      "@aihu/store": ["../store/src/index.ts"],
      // Paired with the bare mapping below: tsconfig `paths` matching is exact,
      // so "@aihu/context" never covered the "/ssr" subpath — it resolved
      // through package exports to ../context/dist/ssr.d.ts while the rest of
      // @aihu/context came from source (packages/app/src/prerender.ts is the
      // importer, reached from here through the @aihu/app mapping). Same
      // src-vs-dist split as @aihu/arbor/hydrate in packages/app; map it to
      // source so the package resolves one way, and so tsc agrees with
      // vitest.config.ts.
      "@aihu/context/ssr": ["../context/src/ssr.ts"],
      "@aihu/context": ["../context/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
