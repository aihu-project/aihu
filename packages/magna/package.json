{
  "name": "@aihu/magna",
  "version": "0.2.8",
  "description": "aihu bridge for Magna GraphQL — dep-free fetch, resource composition, JWT relay",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codegen": {
      "import": "./dist/codegen.js",
      "types": "./dist/codegen.d.ts"
    }
  },
  "files": [
    "dist",
    "install-manifest.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/signals": "^0.5.1",
    "@aihu/plugin": "workspace:*",
    "@aihu/context": "workspace:*",
    "@aihu-plugin/data": "workspace:*"
  },
  "devDependencies": {
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/magna"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/magna#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
