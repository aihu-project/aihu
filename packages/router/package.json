{
  "name": "@aihu/router",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/context": "workspace:*",
    "@aihu/server": "workspace:*",
    "@aihu/signals": "^0.5.1"
  },
  "description": "File-based router for the aihu meta-framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/router#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
