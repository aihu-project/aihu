{
  "name": "vscode-aihu",
  "displayName": "Aihu",
  "description": "Syntax highlighting, snippets, and language support for .aihu Single File Components",
  "version": "1.0.0",
  "publisher": "fellwork",
  "license": "MIT",
  "main": "./dist/client/index.js",
  "activationEvents": [
    "onLanguage:aihu"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aihu",
    "web components",
    "sfc",
    "signals",
    "custom elements"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aihu-project/aihu"
  },
  "contributes": {
    "languages": [
      {
        "id": "aihu",
        "aliases": [
          "Aihu",
          "aihu"
        ],
        "extensions": [
          ".aihu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aihu",
        "scopeName": "source.aihu",
        "path": "./syntaxes/aihu.tmLanguage.json",
        "embeddedLanguages": {
          "meta.block.state.aihu source.ts": "typescript",
          "meta.block.template.aihu text.html": "html",
          "meta.block.style.aihu source.css": "css",
          "meta.block.agent.aihu source.ts": "typescript",
          "meta.block.route.aihu source.yaml": "yaml"
        }
      }
    ],
    "snippets": [
      {
        "language": "aihu",
        "path": "./snippets/aihu.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vscode:prepublish": "tsc -p tsconfig.json",
    "build:vsix": "vsce package",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "dependencies": {
    "@aihu/language-server": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.5"
  }
}
