    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/agent-server"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/agent-server#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
