    "./dist/element.js",
    "./dist/markdown-element.js"
  ],
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@kindly-note/core": "^0.2.0",
    "@kindly-note/emitters-html": "^0.1.0",
    "@kindly-note/loader-dynamic-import": "^0.1.0",
    "@kindly-note/render-markdown": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@kindly-note/core": {
      "optional": true
    },
    "@kindly-note/emitters-html": {
      "optional": true
    },
    "@kindly-note/loader-dynamic-import": {
      "optional": true
    },
    "@kindly-note/render-markdown": {
      "optional": true
    }
  },
  "dependencies": {
    "@aihu/signals": "^0.5.1"
  },
  "devDependencies": {
    "@aihu/plugin": "workspace:*",
    "@aihu/server": "workspace:*",
    "@kindly-note/core": "^0.2.0",
    "@kindly-note/emitters-html": "^0.1.0",
    "@kindly-note/loader-dynamic-import": "^0.1.0",
