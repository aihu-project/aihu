{
  "name": "@aihu/app",
  "version": "10.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./ssr-document": {
      "types": "./dist/ssr-document.d.ts",
      "import": "./dist/ssr-document.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@aihu/arbor": "workspace:*",
    "@aihu/context": "workspace:*",
    "@aihu/router": "workspace:*",
    "@aihu/runtime": "workspace:*",
    "@aihu/server": "workspace:*",
    "@aihu/signals": "workspace:*",
    "@aihu/store": "workspace:*",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@aihu-plugin/agent-readiness": "workspace:*",
    "@aihu/compiler": "workspace:*",
    "@aihu/primitives": "workspace:*"
  },
  "description": "Top-level app integration — wires runtime, router, and adapters into a Vite app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/app"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/app#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
