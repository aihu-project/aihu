{
  "name": "@aihu/cli",
  "version": "1.3.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aihu": "./dist/bin.js",
    "create-aihu": "./dist/create.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template-manifest": {
      "types": "./dist/template-manifest.d.ts",
      "import": "./dist/template-manifest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/mcp": "workspace:*"
  },
  "devDependencies": {
    "@aihu/ui": "^0.1.1"
  },
  "description": "Aihu CLI (`aihu`, `create-aihu`) — scaffolding, dev, build commands.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/cli#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
