  },
  "description": "Async-context-friendly request/SSR context primitives for aihu.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/context"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/context#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
