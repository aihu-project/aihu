{
  "name": "@aihu/css-engine",
  "version": "0.6.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "import": "./dist/packs.js",
      "default": "./dist/packs.js"
    },
    "./styles/aihu-default.css": "./styles/aihu-default.css",
    "./styles/aihu-graphite.css": "./styles/aihu-graphite.css",
    "./styles/*": "./styles/*",
    "./runtime/cn": {
      "types": "./dist/runtime/cn.d.ts",
      "import": "./dist/runtime/cn.js"
    },
    "./runtime/progressive": {
      "types": "./dist/runtime/progressive.d.ts",
      "import": "./dist/runtime/progressive.js"
    }
  },
  "files": [
    "dist",
    "crates",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@aihu/arbor": "^4.1.2",
    "@aihu/compiler": "^1.3.2"
  },
  "optionalDependencies": {
    "@aihu/css-engine-darwin-arm64": "0.1.17",
    "@aihu/css-engine-darwin-x64": "0.1.17",
    "@aihu/css-engine-linux-x64-gnu": "0.1.17",
    "@aihu/css-engine-win32-x64-msvc": "0.1.17"
  },
  "scripts": {
    "build": "bun run gen:style-packs && rolldown -c",
    "build:rust": "cargo build --release -p aihu-css-core",
    "gen:cn-map": "bun scripts/gen-cn-conflict-map.ts",
    "gen:style-packs": "bun scripts/gen-style-packs.ts",
    "gen:animations-gallery": "bun scripts/gen-animations-gallery.ts",
    "test": "vitest run",
    "test:rust": "cargo test -p aihu-css-core",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:rust && bun run gen:cn-map && bun run gen:style-packs && bun run build"
  },
  "description": "aihu CSS engine \u2014 Tailwind v4 hard fork with WC-native scoped output.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu.git",
    "directory": "packages/css-engine"
  },
  "homepage": "https://github.com/aihu-project/aihu/tree/main/packages/css-engine#readme",
  "bugs": "https://github.com/aihu-project/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
